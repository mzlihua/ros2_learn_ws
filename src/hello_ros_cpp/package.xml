<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hello_ros_cpp</name>
  <version>0.0.0</version>
  <description>ROS 2 核心基础练习包（C++ 版）：用 rclcpp 重写 hello_ros 里的示例节点</description>
  <maintainer email="3581703344@qq.com">mzlihua</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>rclcpp_components</depend>
  <!-- RobotStatus 里嵌套了 geometry_msgs/Point，这里是【不】补的 ——
       cpp-02 实测：不补 geometry_msgs 也不报错，嵌套依赖由接口包自己传递过去。
       （第 6 关「嵌套消息的两处 DEPENDENCIES」的同一件事，那次是 Python 包。） -->
  <depend>hello_ros_interfaces</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
